<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors (design/tokens.json): the dark theme. Controls/Palette.cs recolours these brushes for light and contrast themes. -->
    <Color x:Key="BgColor">#0E1116</Color>
    <Color x:Key="AccentColor">#F0A848</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#0E1116" />
    <SolidColorBrush x:Key="NavBgBrush" Color="#0B0E12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171B22" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1F242D" />
    <SolidColorBrush x:Key="SurfaceChipBrush" Color="#232934" />
    <SolidColorBrush x:Key="PlayerPaneBrush" Color="#12161C" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="#141820" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1A1F27" />
    <SolidColorBrush x:Key="LineBrush" Color="#1F242D" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#2A303A" />
    <SolidColorBrush x:Key="LineDashedBrush" Color="#3A414D" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEEF1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C9CED6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA3AF" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#6B7482" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F0A848" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F7C47E" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1205" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#9BD39A" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#1E3324" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F0C27A" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="#2A2312" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4A3B17" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#F3E3C3" />
    <SolidColorBrush x:Key="WarningStrongBrush" Color="#FFF1D6" />
    <SolidColorBrush x:Key="BadgeAmberBgBrush" Color="#3A2A12" />
    <SolidColorBrush x:Key="CoverTextBrush" Color="#F3E9D7" />
    <SolidColorBrush x:Key="OnSpeakerBrush" Color="#10141A" />
    <SolidColorBrush x:Key="ProgressAudioBrush" Color="#7FB2F0" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#ECEEF1" />
    <SolidColorBrush x:Key="SliderThumbHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HighlightTextBrush" Color="#FFF8EC" />

    <!-- Type -->
    <FontFamily x:Key="UiFont">ms-appx:///Assets/Fonts/Manrope.ttf#Manrope</FontFamily>
    <FontFamily x:Key="BookFont">ms-appx:///Assets/Fonts/Literata.ttf#Literata</FontFamily>

    <!-- Make every built-in control use Manrope and the amber accent. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Manrope.ttf#Manrope</FontFamily>
    <Color x:Key="SystemAccentColor">#F0A848</Color>
    <Color x:Key="SystemAccentColorLight1">#F7C47E</Color>
    <Color x:Key="SystemAccentColorLight2">#F7C47E</Color>
    <Color x:Key="SystemAccentColorLight3">#F7C47E</Color>
    <Color x:Key="SystemAccentColorDark1">#D8923A</Color>
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#F0A848" />
    <!-- Progress bars draw the design's 6–8 px rounded track instead of a hairline. -->
    <x:Double x:Key="ProgressBarTrackHeight">6</x:Double>
    <x:Double x:Key="ProgressBarMinHeight">6</x:Double>
    <CornerRadius x:Key="ProgressBarTrackCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ProgressBarCornerRadius">3</CornerRadius>

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="-30" />
    </Style>
    <Style x:Key="ScreenTitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>
    <Style x:Key="BookTitleLgText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource BookFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="27" />
    </Style>
    <Style x:Key="BookTitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource BookFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="ReadingText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource BookFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="27" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="BigNumberText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="-30" />
    </Style>
</ResourceDictionary>
