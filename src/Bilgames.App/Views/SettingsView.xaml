<UserControl
    x:Class="Bilgames.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Bilgames.App.Controls"
    xmlns:vm="using:Bilgames.App.ViewModels"
    AutomationProperties.Name="Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Body" Spacing="20" Padding="28,28,28,24" MaxWidth="820" HorizontalAlignment="Left">
            <Button x:Name="BackButton" Style="{StaticResource LinkButton}" Click="Back_Click" AutomationProperties.Name="Back to library">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:StrokeIcon Data="M15 5l-7 7 7 7" Width="18" Height="18" StrokeWidth="2.2" />
                    <TextBlock Text="Library" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind Vm.Version, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource BaseText}" />
            </StackPanel>

            <!-- Updates -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Updates" Style="{StaticResource SectionText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="14"
                               Text="New versions are published on GitHub (silent-diffusion/Bilgames-Reader)." />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Check for updates when the app starts" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Off by default." Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.AutoCheck, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" IsEnabled="{x:Bind Vm.CanUpdate, Mode=OneWay}"
                                      AutomationProperties.Name="Check for updates when the app starts" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource GhostButton}" MinHeight="44" FontSize="14" Content="Check for updates" Command="{x:Bind Vm.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind Vm.CanUpdate, Mode=OneWay}" />
                        <Button Style="{StaticResource AccentButton}" MinHeight="44" FontSize="14" Content="{x:Bind Vm.InstallLabel, Mode=OneWay}" Command="{x:Bind Vm.InstallUpdateCommand}"
                                Visibility="{x:Bind c:Ui.Vis(Vm.UpdateAvailable), Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind Vm.IsUpdating, Mode=OneWay}" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.UpdateStatus, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind c:Ui.VisText(Vm.UpdateStatus), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Processing: CPU or GPU -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Processing" Style="{StaticResource SectionText}" AutomationProperties.HeadingLevel="Level2" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Prefer the GPU" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Uses the graphics card when it has free memory. If it runs short, work moves to the CPU and returns to the GPU once memory frees up — without stopping." Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.PreferGpu, Mode=TwoWay}" OnContent="GPU" OffContent="CPU" MinWidth="0" IsEnabled="{x:Bind Vm.HasGpu, Mode=OneWay}"
                                      AutomationProperties.Name="Prefer the GPU" />
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="12,10" CornerRadius="10" Background="{StaticResource InfoBgBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Style="{StaticResource BaseText}"><Run Text="Processing on " /><Run Text="{x:Bind Vm.DeviceNow, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource CaptionText}"><Run Text="Graphics card: " /><Run Text="{x:Bind Vm.GpuName, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{x:Bind Vm.DeviceDetail, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind c:Ui.VisText(Vm.DeviceDetail), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <c:GpuMemoryPanel Report="{x:Bind Vm.GpuMemory, Mode=OneWay}" />
                    <Button Style="{StaticResource AccentButton}" MinHeight="44" FontSize="14" HorizontalAlignment="Left" Content="Download GPU model" Command="{x:Bind Vm.DownloadGpuModelCommand}"
                            Visibility="{x:Bind c:Ui.Vis(Vm.GpuNeedsModel), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Voice models -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Voice models" Style="{StaticResource SectionText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="14"
                               Text="Kokoro 82M voice models (Apache-2.0). Each is a one-time download." />
                    <ItemsControl ItemsSource="{x:Bind Vm.Models}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelRowViewModel">
                                <Grid MinHeight="60" ColumnSpacing="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Padding="0,8">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}" />
                                        <TextBlock Style="{StaticResource CaptionText}"><Run Text="{x:Bind Detail, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Use}" /></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" MinHeight="40" Content="Download" Click="DownloadModel_Click" Tag="{x:Bind}" Visibility="{x:Bind c:Ui.NotVis(Installed), Mode=OneWay}" />
                                        <Button Style="{StaticResource GhostButton}" MinHeight="40" Content="Delete" Click="DeleteModel_Click" Tag="{x:Bind}" Visibility="{x:Bind c:Ui.Vis(Installed), Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind Vm.DownloadStatus, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind c:Ui.VisText(Vm.DownloadStatus), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Narration -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Narration" Style="{StaticResource SectionText}" AutomationProperties.HeadingLevel="Level2" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Narrator voice for new books" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Each book's narrator can also be changed on its Cast tab." Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SmallOutlineButton}" MinWidth="220" MinHeight="40" HorizontalContentAlignment="Left" VerticalAlignment="Center" Click="Narrator_Click"
                                AutomationProperties.Name="{x:Bind Vm.NarratorButtonName, Mode=OneWay}">
                            <TextBlock FontSize="13"><Run Text="{x:Bind Vm.DefaultNarrator.Label, Mode=OneWay}" /><Run Text="  ▾" /></TextBlock>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Storage" Style="{StaticResource SectionText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind Vm.StorageSummary, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="14" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Keep segment cache" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Lets speaker fixes regenerate only the lines that changed. Uses about 170 MB per hour of audio." Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.KeepSegmentCache, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Keep segment cache" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource GhostButton}" MinHeight="44" Content="Clear segment caches…" Command="{x:Bind Vm.ClearCachesCommand}" />
                        <Button Style="{StaticResource GhostButton}" MinHeight="44" Content="Open data folder" Command="{x:Bind Vm.OpenDataFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.DataFolder, Mode=OneWay}" Style="{StaticResource CaptionText}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Privacy" Style="{StaticResource SectionText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="14" LineHeight="21"
                               Text="Books, their text, speaker analysis, voice choices, generated audio and listening history stay on this device. The app only goes online when you click a Download or Check for updates button (or turn on automatic update checks). No analytics or crash reports are sent. Only import books you're entitled to use; DRM-protected EPUBs are refused." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
