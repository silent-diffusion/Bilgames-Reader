<UserControl
    x:Class="Bilgames.App.Views.NotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Bilgames.App.Controls"
    xmlns:vm="using:Bilgames.App.ViewModels"
    AutomationProperties.Name="Notes">

    <Grid x:Name="Body" Padding="28,28,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title, summary, export -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <Button x:Name="BackButton" Style="{StaticResource LinkButton}" Click="Back_Click" AutomationProperties.Name="Back to library">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <c:StrokeIcon Data="M15 5l-7 7 7 7" Width="18" Height="18" StrokeWidth="2.2" />
                        <TextBlock Text="Library" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Notes" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Command="{x:Bind Vm.ExportCommand}" IsEnabled="{x:Bind Vm.HasResults, Mode=OneWay}"
                    AutomationProperties.Name="Export what's shown" ToolTipService.ToolTip="Save what's shown as Markdown, plain text or CSV">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:StrokeIcon Data="M12 3v12M7 10l5 5 5-5M5 21h14" Width="16" Height="16" />
                    <TextBlock Text="Export" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters -->
        <Border x:Name="FilterStrip" Grid.Row="1" Style="{StaticResource SegmentTrack}" Width="460" HorizontalAlignment="Left">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <c:SegmentToggle Grid.Column="0" Style="{StaticResource SegmentButton}" Content="All" IsChecked="{x:Bind Vm.IsAll, Mode=OneWay}" Command="{x:Bind Vm.ShowAllCommand}" />
                <c:SegmentToggle Grid.Column="1" Style="{StaticResource SegmentButton}" Content="Bookmarks" IsChecked="{x:Bind Vm.IsBookmarks, Mode=OneWay}" Command="{x:Bind Vm.ShowBookmarksCommand}" />
                <c:SegmentToggle Grid.Column="2" Style="{StaticResource SegmentButton}" Content="Highlights" IsChecked="{x:Bind Vm.IsHighlights, Mode=OneWay}" Command="{x:Bind Vm.ShowHighlightsCommand}" />
                <c:SegmentToggle Grid.Column="3" Style="{StaticResource SegmentButton}" Content="Notes" IsChecked="{x:Bind Vm.IsWithNotes, Mode=OneWay}" Command="{x:Bind Vm.ShowWithNotesCommand}"
                                 AutomationProperties.Name="With notes" />
            </Grid>
        </Border>

        <!-- Search and sort -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search text, notes, books or chapters"
                     AutomationProperties.Name="Search bookmarks, highlights and notes" MinHeight="40" />
            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.ByBook, Mode=TwoWay}" OnContent="By book" OffContent="Newest first" MinWidth="0" VerticalAlignment="Center"
                          AutomationProperties.Name="Group by book" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{x:Bind Vm.EmptyText, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap" MaxWidth="460"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0" Visibility="{x:Bind c:Ui.NotVis(Vm.HasResults), Mode=OneWay}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Visibility="{x:Bind c:Ui.Vis(Vm.HasResults), Mode=OneWay}">
            <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <ItemsRepeater x:Name="List" ItemsSource="{x:Bind Vm.Items}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:GlobalNoteItem">
                            <Grid Background="{StaticResource SurfaceBrush}" CornerRadius="12" ColumnSpacing="14" Padding="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{x:Bind c:Ui.Brush(Swatch)}" CornerRadius="12,0,0,12" />
                                <c:CoverView Grid.Column="1" Width="40" Height="58" Radius="4" TitleSize="6" Margin="0,12,0,12" VerticalAlignment="Top"
                                             Title="{x:Bind BookTitle}" CoverColor="{x:Bind CoverColor}" ImagePath="{x:Bind CoverPath}" />
                                <Button Grid.Column="2" Style="{StaticResource RowButton}" Padding="0,12,0,12" HorizontalContentAlignment="Left"
                                        Click="Open_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind OpenName}" ToolTipService.ToolTip="Play from here">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="11" FontWeight="Bold" CharacterSpacing="60" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource BaseText}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind KindLabel}" /><Run Text=" Â· " /><Run Text="{x:Bind Caption}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{x:Bind When}" Style="{StaticResource CaptionText}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Text}" FontFamily="{StaticResource BookFont}" FontSize="16" LineHeight="24" TextWrapping="Wrap" MaxLines="6" TextTrimming="WordEllipsis" Style="{StaticResource BaseText}" />
                                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Visibility="{x:Bind c:Ui.Vis(HasNote)}">
                                            <TextBlock Text="{x:Bind Note}" FontSize="13" FontStyle="Italic" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource BaseText}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="0,8,0,0">
                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" Click="Edit_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind EditName}" ToolTipService.ToolTip="{x:Bind EditName}">
                                        <c:StrokeIcon Data="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" Click="Delete_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind DeleteName}" ToolTipService.ToolTip="{x:Bind DeleteName}">
                                        <c:StrokeIcon Data="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" Width="15" Height="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource SuccessBrush}" Visibility="{x:Bind c:Ui.VisText(Vm.Status), Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
